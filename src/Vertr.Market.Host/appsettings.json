{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": {
      "ConsoleSink": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}][{ThreadId}][{SourceContext}] {Message:lj} {NewLine}{Exception}"
        }
      },
      "FileSink": {
        "Name": "File",
        "Args": {
          "path": "host.log",
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}][{ThreadId}][{SourceContext}] {Message:lj} {NewLine}{Exception}",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": "10000000000",
          "shared": true,
          "retainedFileCountLimit": 10,
          "rollingInterval": "Day"
        }
      }
    }
  },
  "ConnectionStrings": {
    "RedisConnection": "localhost"
  },
  "TinvestGateway": {
    "BaseAddress": "http://localhost:8085"
  },
  "VertrForecastGateway": {
    "BaseAddress": "http://localhost:8081"
  },
  "SubscriptionSettings": {
    "Portfolios": {
      "Channel": "portfolios",
      "IsEnabled": true
    },
    "OrderBooks": {
      "Channel": "market.orderBooks",
      "IsEnabled": true
    },
    "Candles": {
      "Channel": "market.candles.*",
      "IsEnabled": false
    }
  },
  "ThresholdSettings": {
    "ThresholdValue": 0.0002,
    "ThresholdSigma": 1,
    "UseStatsThreshold": false
  },
  "IndexRates": [
    "RUSFAR",
    "RUSFAR3M"
  ]
}
