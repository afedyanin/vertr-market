{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Grpc.Net.Client": "Warning"
      }
    },
    "WriteTo": {
      "ConsoleSink": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}][{ThreadId}][{SourceContext}] {Message:lj} {NewLine}{Exception}"
        }
      },
      "FileSink": {
        "Name": "File",
        "Args": {
          "path": "host.log",
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}][{ThreadId}][{SourceContext}] {Message:lj} {NewLine}{Exception}",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": "10000000000",
          "shared": true,
          "retainedFileCountLimit": 10,
          "rollingInterval": "Day"
        }
      }
    }
  },
  "InvestApiSettings": {
    "AppName": "VERTR",
    "Sandbox": true,
    "AccessToken": "<>"
  },
  "TinvestMarketDataSettings": {
    "IsEnabled": true,
    "Assets": {
      "e6123145-9665-43e0-8413-cd61b8aa9b13": 100, // SBER
      "f532beef-65bb-4a42-894c-e9bc728f93c4": 200, // SRU6: SBRF-9.26 Сбер Банк (обыкновенные)
      "fd32e9a3-d386-48fd-b0a8-0c1cc2ae95c6": 300, // SRZ6: SBRF-12.26 Сбер Банк (обыкновенные)
      "04fe67cf-0bb7-492c-84cc-40945fc0eec0": 400  // SRH7: SBRF-3.27 Сбер Банк (обыкновенные)
    }
  }
}
